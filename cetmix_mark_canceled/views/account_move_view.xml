<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_canceled" model="ir.ui.view">
        <field name="name">account.move.form.inherit.canceled</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//group" position="inside">
                <group string="Custom Status">
                    <field name="is_canceled"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_inherit_canceled" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.canceled</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_canceled" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>